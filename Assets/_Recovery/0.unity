  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Es una enfermedad viral altamente contagiosa que afecta a gatos
    de todas las edades. \n\n\u2022 Es causada por un virus que ataca principalmente
    el sistema respiratorio y la cavidad oral. \n\n\u2022 Se transmite principalmente
    por el contacto directo con secreciones de un gato infectado, como saliva, mucosidad
    o l\xE1grimas, as\xED como por objetos contaminados como platos, juguetes o manos."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 33fcd1409da09854db320c6969dc69be, type: 2}
  m_sharedMaterial: {fileID: 1026581995830283892, guid: 33fcd1409da09854db320c6969dc69be, type: 2}

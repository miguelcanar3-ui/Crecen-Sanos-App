  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Debe continuar consumiendo alimento para gatitos hasta alcanzar
    la edad recomendada para cambiar a alimento de adulto.\n\n\u2022 Dependiendo
    de la raza y el tama\xF1o, la transici\xF3n del alimento de gatito al de adulto
    se realiza generalmente entre los 10 y 12 meses. Este cambio debe hacerse de
    manera gradual, mezclando ambos alimentos durante 7 a 10 d\xEDas para evitar
    trastornos gastrointestinales.\n\r\n\u2022 Mantener el h\xE1bito adquirido en
    meses anteriores de consumir alimento h\xFAmedo (sobres o latas) de forma regular
    es indispensable."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}

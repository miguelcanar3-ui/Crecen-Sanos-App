  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 PERROS PEQUE\xD1OS: Comer 2 o 3 comidas al d\xEDa, ya que queman
    energ\xEDa m\xE1s r\xE1pido y pueden sufrir bajadas de az\xFAcar.\n\n\u2022 PERROS
    MEDIANOS Y GRANDES: 2 comidas al d\xEDa son suficientes.\n\r\n\u2022 PERROS EXTRAGRANDES:
    2 o 3 comidas peque\xF1as ayudan a prevenir la peligrosa hinchaz\xF3n o torsi\xF3n
    g\xE1strica.\n\r\n\u2022 Comer muy r\xE1pido o hacer mucho ejercicio justo despu\xE9s
    de comer puede hacer que su est\xF3mago se tuerza, lo cual es una urgencia m\xE9dica
    grave.\n\r\n\u2022 El cambio de alimento para cachorro a alimento para adulto
    debe realizarse de manera gradual para evitar trastornos digestivos."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}

  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Su est\xF3mago es m\xE1s grande y ya puede guardar comida por m\xE1s
    tiempo. Por lo tanto, quitarles una comida (pasar de 4 a 3 comidas) les ayuda
    a tener mejores horarios para ir al ba\xF1o.\n\n\u2022 El crecimiento durante
    esta etapa es muy r\xE1pido, por lo que una alimentaci\xF3n equilibrada es fundamental.\n\r\n\u2022
    Es importante controlar las porciones para evitar tanto la desnutrici\xF3n como
    el sobrepeso.\n\r\n\u2022 Los cambios bruscos en la alimentaci\xF3n pueden causar
    problemas digestivos, as\xED que cualquier transici\xF3n debe hacerse gradualmente."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}
  m_sharedMaterial: {fileID: 752653750078228413, guid: b5197b56616f17549ab4b668336c4969, type: 2}

  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 El cachorro debe beber la primera leche de la madre (calostro)
    durante las primeras 24 horas de vida.\r\n\r\n\u2022 Solo deben tomar leche materna.
    Si no tienen a su mam\xE1, necesitar\xE1n tomar leche de f\xF3rmula especial
    para perros.\r\n\r\n\u2022 Deben comer varias veces al d\xEDa, ya que son reci\xE9n
    nacidos y todav\xEDa no pueden almacenar mucha energ\xEDa en su cuerpo.\r\n\r\n\u2022
    Nunca se les debe dar leche de vaca, ya que puede causar diarrea y deshidrataci\xF3n."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}
  m_sharedMaterial: {fileID: 752653750078228413, guid: b5197b56616f17549ab4b668336c4969, type: 2}

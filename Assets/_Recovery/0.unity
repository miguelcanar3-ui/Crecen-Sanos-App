  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Es la etapa del destete. Ya tienen la mayor\xEDa de los dientes
    de leche y necesitan empezar a masticar.\n\n\u2022 Hay que empezar a darles croquetas
    para cachorro remojadas en agua tibia o en su leche de f\xF3rmula, hasta formar
    una papilla.\n\r\n\u2022 La leche materna sigue siendo importante durante las
    primeras semanas de esta etapa, pero su consumo disminuye progresivamente.\n\r\n\u2022
    Necesitan consumir el alimento en porciones peque\xF1as distribuidas a lo largo
    del d\xEDa y tener acceso constante a agua fresca y limpia."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}
  m_sharedMaterial: {fileID: 752653750078228413, guid: b5197b56616f17549ab4b668336c4969, type: 2}

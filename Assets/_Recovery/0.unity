  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Has marcado que tu perrito ya recibi\xF3 la Rabia + Traqueobronquitis.
    Si la vacuna Traqueobronquitis fue aplicada v\xEDa inyecci\xF3n, se necesitar\xE1
    una segunda dosis despu\xE9s de 3 semanas.\n\n\xBFC\xF3mo fue aplicada la vacuna?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}

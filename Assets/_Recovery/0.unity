  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Ya tienen la mayor\xEDa de los dientes de leche y necesitan empezar
    a masticar.\L\n\u2022 El destete empieza a partir de la sexta semana.\n\n\u2022
    Hay que empezar a darles croquetas para gatito remojadas en agua tibia o en su
    leche de f\xF3rmula, hasta formar una papilla.\n\r\n\u2022 La leche materna sigue
    siendo importante durante las primeras semanas de esta etapa, pero su consumo
    disminuye progresivamente.\n\r\n\u2022 Inicialmente, la consistencia de la papilla
    debe ser muy l\xEDquida e ir espes\xE1ndose gradualmente.\n\r\n\u2022 Deja su
    raci\xF3n diaria a libre disposici\xF3n para que coma en m\xFAltiples porciones
    a lo largo del d\xEDa. Es importante medir la cantidad total diaria para prevenir
    el sobrepeso y debe tener acceso constante a agua fresca y limpia."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}
  m_sharedMaterial: {fileID: 752653750078228413, guid: b5197b56616f17549ab4b668336c4969, type: 2}

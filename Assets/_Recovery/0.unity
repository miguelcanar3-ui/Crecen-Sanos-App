  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Es una enfermedad viral muy grave que pueden contraer perros de
    todas las edades.\n\n \u2022 Afecta principalmente el est\xF3mago y los intestinos.
    \n\n\u2022 Se propaga por contacto directo entre perros, por heces contaminadas,
    superficies infectadas o incluso a trav\xE9s del calzado o las manos que hayan
    estado en contacto con el virus."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 33fcd1409da09854db320c6969dc69be, type: 2}
  m_sharedMaterial: {fileID: 1026581995830283892, guid: 33fcd1409da09854db320c6969dc69be, type: 2}

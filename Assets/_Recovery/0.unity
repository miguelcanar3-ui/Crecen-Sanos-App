  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 El gatito debe beber la primera leche de la madre (calostro) durante
    las primeras 24 horas de vida.\n\n\u2022 En esta etapa solo toman leche materna.
    Si son gatitos hu\xE9rfanos, hay que usar leche de f\xF3rmula especial para gatos
    y d\xE1rsela con biber\xF3n.\n\n\u2022 Deben comer varias veces al d\xEDa, ya
    que son reci\xE9n nacidos y todav\xEDa no pueden almacenar mucha energ\xEDa en
    su cuerpo.\n\r\n\u2022 Nunca se les debe dar leche de vaca, ya que puede causar
    diarrea y deshidrataci\xF3n.\n\r\n\u2022 Un gatito no puede procesar el alimento
    si tiene fr\xEDo. Si su temperatura corporal baja, el tracto gastrointestinal
    se paraliza. Nunca se debe alimentar a un gatito fr\xEDo; primero hay que darle
    calor."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}
  m_sharedMaterial: {fileID: 752653750078228413, guid: b5197b56616f17549ab4b668336c4969, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}

  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Es una enfermedad viral altamente contagiosa que afecta principalmente
    a gatos j\xF3venes, aunque puede presentarse a cualquier edad.\n\n\u2022 Es causada
    por un virus muy resistente en el ambiente, conocido como parvovirus felino.
    Este virus ataca principalmente el sistema digestivo, el sistema inmunol\xF3gico
    y, en algunos casos, el sistema nervioso. \n\n\u2022 Se transmite por el contacto
    con heces, v\xF3mito, superficies contaminadas o incluso a trav\xE9s de objetos
    como platos, camas o manos que hayan estado en contacto con un gato infectado."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 33fcd1409da09854db320c6969dc69be, type: 2}
  m_sharedMaterial: {fileID: 1026581995830283892, guid: 33fcd1409da09854db320c6969dc69be, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []

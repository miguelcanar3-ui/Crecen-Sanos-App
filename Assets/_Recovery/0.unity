  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022\tYa tienen casi el tama\xF1o de un perro adulto (especialmente
    las razas peque\xF1as y medianas). Su cuerpo no necesita estar comiendo a cada
    rato.\n\u2022\tEn esta etapa se acostumbran a la rutina de comer solo en la ma\xF1ana
    y en la noche, dependiendo de la raza del perro."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

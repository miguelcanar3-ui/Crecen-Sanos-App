  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Los gatos adultos, especialmente aquellos de interior (indoor)
    y esterilizados, tienen un gasto cal\xF3rico notablemente bajo. Es vital medir
    las raciones diarias con exactitud. El sobrepeso en la etapa adulta es el principal
    detonante de la diabetes felina y la osteoartritis.\n\n\u2022 Mantener el h\xE1bito
    diario de dar alimento mixto (seco y h\xFAmedo) es la mejor estrategia preventiva
    para evitar problemas urinarios."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b5197b56616f17549ab4b668336c4969, type: 2}
  m_sharedMaterial: {fileID: 752653750078228413, guid: b5197b56616f17549ab4b668336c4969, type: 2}
